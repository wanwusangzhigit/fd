<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 备份 / 设备迁移配置。我们对接收到的文件持谨慎态度（不应被自动
  备份到云端或迁移到新设备），所以全部排除。应用自身的偏好与缓存走默认行为。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
